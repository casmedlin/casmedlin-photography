---
import Layout from '../../layouts/Layout.astro';
import dimensions from '../../data/image-dimensions.json';

function getDims(src) {
  const cleanSrc = src.startsWith('/') ? src.slice(1) : src;
  const parts = cleanSrc.split('/');
  const file = parts.pop();
  const folder = parts[parts.length - 1] || 'root';
  return dimensions[folder]?.[file] || { width: 800, height: 600 };
}

const images = [
  { src: '/graphic-design/how-to-guide/preview.webp', alt: 'How-to guide brochure cover with tent at night and cliffs, featuring ALs logo' },
  { src: '/graphic-design/how-to-guide/guide1.webp', alt: 'How-to guide beginners page by Cas Medlin' },
  { src: '/graphic-design/how-to-guide/guide2.webp', alt: 'Gear section with equipment photos and descriptions' },
  { src: '/graphic-design/how-to-guide/guide3.webp', alt: 'Backpack checklist page' },
  { src: '/graphic-design/how-to-guide/guide4.webp', alt: 'Testing section with hikers carrying backpacks' },
  { src: '/graphic-design/how-to-guide/guide5.webp', alt: 'Trail photos and location selection information' },
  { src: '/graphic-design/how-to-guide/guide6.webp', alt: 'Camping info with orange tent at sunset on rocky shore' },
  { src: '/graphic-design/how-to-guide/guide7.webp', alt: 'Additional backpacking guide content by Cas Medlin' },
];
---

<Layout title="How-To Guide Brochure — ALs Sporting Goods | Cas Medlin" description="Backpacking how-to guide brochure concept by Cas Medlin. Educational InDesign project." image="/graphic-design/how-to-guide/preview.webp" breadcrumbs={[{ name: 'Graphic Design', url: '/graphic-design' }, { name: 'How-To Guide', url: '/graphic-design/how-to-guide' }]}>
  <div class="project-header">
    <a href="/graphic-design" class="back-link">&larr; Back to Graphic Design</a>
    <span class="card-category">Print Design</span>
    <h1>How-To Guide Brochure &mdash; ALs Sporting Goods</h1>
  </div>

  <div class="project-gallery">
    {images.map((img) => {
      const dims = getDims(img.src);
      return (
        <div class="gallery-item">
          <img src={img.src} alt={img.alt} width={dims.width} height={dims.height} loading="lazy" />
        </div>
      );
    })}
  </div>

  <div class="project-content">
    <p>This project was created for an InDesign course at Mitchell Community College. All images and vector assets are utilized under Fair Use guidelines for educational purposes. This is a concept project using ALs as a reference brand and is not intended for commercial use. AL's Sporting Store is in no way associated with this project. I just really love AL's Sporting Goods because of their incredible selection and prices.</p>
    <p>The cover features a tent at night with cliffs behind, an ALs logo, and the text "beginners guide." Inside, one side covers gear with photos and descriptions, while the other side has a backpack checklist. Both pages include testing content with photos of people hiking with their backpacks. Additional pages feature trail photos and location selection info, plus camping info with a picture of an orange tent at sunset on a rocky shore.</p>
    <p>All design work was created by Cas Medlin, a freelance graphic designer and photographer. Whether you need a how-to guide or another type of brochure, I am ready to collaborate. Do not hesitate to reach out today to discuss your next project: <a href="mailto:info@casmedlin.com" style="color:#22c55e">info@casmedlin.com</a></p>
    <a href="https://www.behance.net/casmedlin" target="_blank" rel="noopener" class="project-link">View on Behance</a>
  </div>

  <div class="nav-buttons">
    <a href="/graphic-design/for-king-country" class="nav-button">&lt; Prev</a>
    <a href="/graphic-design/flyer-design" class="nav-button">Next &gt;</a>
  </div>
</Layout>

<style>
  .project-header { padding: 0 0.5rem; margin-bottom: 1.5rem; }
  .back-link { color: #22c55e; text-decoration: none; font-size: 0.875rem; display: inline-block; margin-bottom: 0.75rem; }
  .back-link:hover { opacity: 0.8; }
  .card-category { display: inline-block; font-size: 0.75rem; color: #22c55e; background: rgba(34,197,94,0.1); padding: 0.125rem 0.5rem; border-radius: 4px; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .project-header h1 { font-size: 1.5rem; font-weight: 600; color: #fff; margin: 0.5rem 0 0; line-height: 1.3; }
  .project-gallery { max-width: 900px; margin: 0 auto 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .gallery-item { border-radius: 10px; overflow: hidden; border: 1px solid #2a2a2a; }
  .gallery-item img { width: 100%; height: auto; display: block; }
  .project-content { max-width: 900px; margin: 0 auto 2rem; padding: 0 0.5rem; }
  .project-content p { color: #a3a3a3; font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; }
  .project-link { display: inline-flex; align-items: center; gap: 0.375rem; color: #22c55e; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
  .project-link:hover { opacity: 0.8; }
</style>
