---
import Layout from '../../layouts/Layout.astro';
import dimensions from '../../data/image-dimensions.json';

function getDims(src) {
  const cleanSrc = src.startsWith('/') ? src.slice(1) : src;
  const parts = cleanSrc.split('/');
  const file = parts.pop();
  const folder = parts[parts.length - 1] || 'root';
  return dimensions[folder]?.[file] || { width: 800, height: 600 };
}

const images = [
  { src: '/graphic-design/summer-maine/hero.webp', alt: 'Summer in Maine booklet mockup display by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd.webp', alt: 'Summer in Maine cover — lighthouse in Acadia with heading by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd2.webp', alt: 'Great drives in Maine and Route 1 spread by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd3.webp', alt: 'Trails and park locations spread by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd4.webp', alt: 'Wildlife and adventure spread by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd5.webp', alt: 'Lodging with sunset and restaurants spread by Cas Medlin' },
  { src: '/graphic-design/summer-maine/GRD155midtermCMedlin2nd6.webp', alt: 'Back cover coastline with visit Maine text by Cas Medlin' },
];
---

<Layout title="Summer in Maine Booklet | Cas Medlin" description="Travel booklet project showcasing Maine summer destinations by Cas Medlin." image="/graphic-design/summer-maine/hero.webp" breadcrumbs={[{ name: 'Graphic Design', url: '/graphic-design' }, { name: 'Summer in Maine', url: '/graphic-design/summer-maine' }]}>
  <div class="project-header">
    <a href="/graphic-design" class="back-link">&larr; Back to Graphic Design</a>
    <span class="card-category">Print Design</span>
    <h1>Summer in Maine Booklet</h1>
  </div>

  <div class="project-gallery">
    {images.map((img) => {
      const dims = getDims(img.src);
      return (
        <div class="gallery-item">
          <img src={img.src} alt={img.alt} width={dims.width} height={dims.height} loading="lazy" />
        </div>
      );
    })}
  </div>

  <div class="project-content">
    <p>This conceptual booklet was created for an InDesign course at Mitchell Community College to promote summer travel to Maine. All text is original, developed through independent research and personal travel experiences. The photography features a blend of my own original images and curated restaurant photography utilized strictly under Fair Use guidelines for educational, non-commercial purposes.</p>
    <p>The cover features a lighthouse in Acadia National Park with the heading "Summer in Maine | The way life should be." One side talks about great drives in Maine and the other covers Route 1. Pages discuss trails on one side and show where different parks and trails are located. Wildlife is shown on one side with an adventure section featuring wildlife pictures. Lodging is covered on one side with a sunset image, and restaurants on the other. The back cover shows a coastline with text about why you should visit Maine.</p>
    <p>All design work and primary photography were created by Cas Medlin, a freelance graphic designer and photographer. Whether you need a travel booklet or a full spread magazine, I am ready to collaborate. Do not hesitate to reach out today to discuss your next project: <a href="mailto:info@casmedlin.com" style="color:#22c55e">info@casmedlin.com</a></p>
    <a href="https://www.behance.net/casmedlin" target="_blank" rel="noopener" class="project-link">View on Behance</a>
  </div>

  <div class="nav-buttons">
    <a href="/graphic-design/can-label" class="nav-button">&lt; Prev</a>
    <a href="/graphic-design/yeti-mag" class="nav-button">Next &gt;</a>
  </div>
</Layout>

<style>
  .project-header { padding: 0 0.5rem; margin-bottom: 1.5rem; }
  .back-link { color: #22c55e; text-decoration: none; font-size: 0.875rem; display: inline-block; margin-bottom: 0.75rem; }
  .back-link:hover { opacity: 0.8; }
  .card-category { display: inline-block; font-size: 0.75rem; color: #22c55e; background: rgba(34,197,94,0.1); padding: 0.125rem 0.5rem; border-radius: 4px; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .project-header h1 { font-size: 1.5rem; font-weight: 600; color: #fff; margin: 0.5rem 0 0; line-height: 1.3; }
  .project-gallery { max-width: 900px; margin: 0 auto 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .gallery-item { border-radius: 10px; overflow: hidden; border: 1px solid #2a2a2a; }
  .gallery-item img { width: 100%; height: auto; display: block; }
  .project-content { max-width: 900px; margin: 0 auto 2rem; padding: 0 0.5rem; }
  .project-content p { color: #a3a3a3; font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; }
  .project-link { display: inline-flex; align-items: center; gap: 0.375rem; color: #22c55e; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
  .project-link:hover { opacity: 0.8; }
</style>
