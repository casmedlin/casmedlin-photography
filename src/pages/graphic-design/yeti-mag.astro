---
import Layout from '../../layouts/Layout.astro';
import dimensions from '../../data/image-dimensions.json';

function getDims(src) {
  const cleanSrc = src.startsWith('/') ? src.slice(1) : src;
  const parts = cleanSrc.split('/');
  const file = parts.pop();
  const folder = parts[parts.length - 1] || 'root';
  return dimensions[folder]?.[file] || { width: 800, height: 600 };
}

const images = [
  { src: '/graphic-design/yeti-mag/hero.webp', alt: 'Yeti Dispatch magazine hero image — mockup display by Cas Medlin' },
  { src: '/graphic-design/yeti-mag/yeti1.webp', alt: 'Yeti Dispatch magazine cover featuring a climber climbing in Yosemite by Cas Medlin' },
  { src: '/graphic-design/yeti-mag/2.webp', alt: 'Table of contents showing a female climber in Utah' },
  { src: '/graphic-design/yeti-mag/3.webp', alt: 'Hero page introducing packing for the desert by Steph Davis' },
  { src: '/graphic-design/yeti-mag/4.webp', alt: 'Continued packing list by Steph Davis' },
  { src: '/graphic-design/yeti-mag/5.webp', alt: 'Advertised water bottles and hero image of Leo Houlding' },
  { src: '/graphic-design/yeti-mag/6.webp', alt: 'Leo Houlding story starts with a large image of him climbing' },
  { src: '/graphic-design/yeti-mag/7.webp', alt: 'Leo Houlding story continues with him on a cliff overlooking the sea drinking water' },
  { src: '/graphic-design/yeti-mag/8.webp', alt: 'Climbing gear with a Yonder bottle on the other side' },
  { src: '/graphic-design/yeti-mag/9.webp', alt: 'Family hiking up a path to a cabin with an article about their adventures' },
  { src: '/graphic-design/yeti-mag/10.webp', alt: 'Two pictures of mountains — one with a cabin, the other with a family and an article' },
  { src: '/graphic-design/yeti-mag/11.webp', alt: 'Family hiking in the mountains with an article about their hikes' },
  { src: '/graphic-design/yeti-mag/12.webp', alt: 'Stackable collection with a woman with a dog near a truck camper' },
  { src: '/graphic-design/yeti-mag/13.webp', alt: 'Woman climbing with an article about camping on public land like a pro' },
  { src: '/graphic-design/yeti-mag/14.webp', alt: 'Woman fishing with an article about camping in the northern Rockies' },
  { src: '/graphic-design/yeti-mag/15.webp', alt: 'Family camping with an article about camping on the beach' },
  { src: '/graphic-design/yeti-mag/16.webp', alt: 'River in Texas starting an article about camping in Texas' },
  { src: '/graphic-design/yeti-mag/17.webp', alt: 'Person surfing with a young girl with an article about camping on an island' },
  { src: '/graphic-design/yeti-mag/18.webp', alt: 'How to see the stars — a woman photographing the Milky Way from a camp' },
  { src: '/graphic-design/yeti-mag/19.webp', alt: 'Large picture of a surfer with ways to prep for surfing huge waves' },
  { src: '/graphic-design/yeti-mag/20.webp', alt: 'Man working out with a list of ways to improve surfing' },
  { src: '/graphic-design/yeti-mag/21.webp', alt: 'Image of a man with a weighted ball in a gym showing the shareable collection' },
  { src: '/graphic-design/yeti-mag/page_42.webp', alt: 'Back cover keeping the other half of the Yosemite picture from the front with shipping info' },
];
---

<Layout title="Yeti Coolers Dispatch Magazine | Cas Medlin" description="Conceptual magazine layout for Yeti Coolers Dispatch by Cas Medlin. Educational InDesign project." image="/graphic-design/yeti-mag/yeti1.webp" breadcrumbs={[{ name: 'Graphic Design', url: '/graphic-design' }, { name: 'Yeti Mag', url: '/graphic-design/yeti-mag' }]}>
  <div class="project-header">
    <a href="/graphic-design" class="back-link">&larr; Back to Graphic Design</a>
    <span class="card-category">Editorial</span>
    <h1>Yeti Coolers Dispatch Magazine</h1>
  </div>

  <div class="project-gallery">
    {images.map((img) => {
      const dims = getDims(img.src);
      return (
        <div class="gallery-item">
          <img src={img.src} alt={img.alt} width={dims.width} height={dims.height} loading="lazy" />
        </div>
      );
    })}
  </div>

  <div class="project-content">
    <p>This project was created for an InDesign course at Mitchell Community College. All images and vector assets are utilized under Fair Use guidelines for educational purposes. This is a conceptual project for Yeti Coolers, inspired by their seasonal dispatch magazines, and is not intended for commercial use. This was made with no association with Yeti Coolers.</p>
    <p>All design work was created by Cas Medlin, a freelance graphic designer and photographer. Whether you need a seasonal magazine layout or a brochure layout, I am ready to collaborate. Do not hesitate to reach out today to discuss your next project: <a href="mailto:info@casmedlin.com" style="color:#22c55e">info@casmedlin.com</a></p>
    <a href="https://www.behance.net/casmedlin" target="_blank" rel="noopener" class="project-link">View on Behance</a>
  </div>

  <div class="nav-buttons">
    <a href="/graphic-design/summer-maine" class="nav-button">&lt; Prev</a>
    <a href="/graphic-design/fusion-bowl-menu" class="nav-button">Next &gt;</a>
  </div>
</Layout>

