const categories = [...new Set(projects.map((p) => p.category))];
---

<Layout
  title="Graphic Design Portfolio | Cas Medlin | Branding & Visual Design"
  description="Graphic design portfolio by Cas Medlin featuring branding, logo design, print design, editorial layout, and packaging. Based in Iredell County, NC."
  image="/favicon.webp"
  breadcrumbs={[{ name: 'Graphic Design', url: '/graphic-design' }]}
>
  <div class="page-header">
    <h1 class="page-title">Graphic Design</h1>
    <p class="page-subtitle">
      Branding, print, editorial, and packaging design projects. Click a project to see more details.
    </p>
  </div>

  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    {categories.map((cat) => (
      <button class="filter-btn" data-filter={cat.toLowerCase()}>{cat}</button>
    ))}
  </div>

  <div class="projects-grid" id="projects-grid">
    {projects.map((project) => (
      <a href={project.slug} class="project-card" data-category={project.category.toLowerCase()}>
        <div class="card-image">
          {(() => {
            const dims = getDims(project.image);
            return <img src={project.image} alt={project.alt} width={dims.width} height={dims.height} loading="lazy" />;
          })()}
        </div>
        <div class="card-body">
          <span class="card-category">{project.category}</span>
          <h2 class="card-title">{project.title}</h2>
          <p class="card-description">{project.description}</p>
          <span class="card-cta">View Project &rarr;</span>
        </div>
      </a>
    ))}
  </div>

  <div class="nav-buttons">
    <a href="/astrophotography" class="nav-button">&lt; Go Back</a>
    <a href="/about" class="nav-button">Next &gt;</a>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }
  .page-title {
    font-size: 0.875rem;
    font-weight: 400;
    color: #fff;
    margin: 1rem 0 0.25rem;
    letter-spacing: 0.05em;
  }
  .page-subtitle {
    color: #a3a3a3;
    font-size: 0.875rem;
    margin: 0;
  }

  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filter-btn {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    color: #a3a3a3;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8125rem;
    transition: all 0.2s;
  }
  .filter-btn:hover {
    border-color: #404040;
    color: #fff;
  }
  .filter-btn.active {
    background: #22c55e;
    color: #151515;
    border-color: #22c55e;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0 0.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    display: block;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.2s;
    text-decoration: none;
  }
  .project-card:hover {
    border-color: #22c55e;
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    background: #222;
    overflow: hidden;
  }
  .card-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .card-body {
    padding: 1rem 1.25rem;
  }

  .card-category {
    display: inline-block;
    font-size: 0.75rem;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .card-description {
    color: #a3a3a3;
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .card-cta {
    color: #22c55e;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 0;
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
