 <style>
   * {
     margin: 0;
     padding: 0;
     box-sizing: border-box;
   }
   img {
     max-width: 100%;
     height: auto;
     display: block;
   }
   body {
     background-color: #151515;
     color: #fff;
     font-family: system-ui, -apple-system, sans-serif;
     min-height: 100vh;
   }
   .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: #22c55e;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    z-index: 200;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0.5rem;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #262626;
  }
  .nav-inner {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo:focus {
    outline: 2px solid #22c55e;
    outline-offset: 2px;
    border-radius: 4px;
  }
  .logo-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  .logo-text {
    display: inline;
    color: #fff;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  @media (max-width: 768px) {
    .logo-img {
      display: block;
    }
    .logo-text {
      display: inline;
    }
    .nav-links {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      background: rgba(10, 10, 10, 0.98);
      flex-direction: column;
      padding: 1rem;
      gap: 1rem;
      display: none;
      border-bottom: 1px solid #262626;
    }
    .nav-links.active {
      display: flex;
    }
    .menu-toggle {
      display: flex;
    }
  }
  .nav-link[aria-current="page"] {
    color: #22c55e;
    font-weight: 600;
  }
  .nav-link {
    font-size: 0.875rem;
    letter-spacing: 0.025em;
    color: #d4d4d4;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover,
  .nav-link:focus {
    color: #22c55e;
    outline: none;
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  .menu-toggle:focus {
    outline: 2px solid #22c55e;
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.3s, opacity 0.3s;
  }
  main {
    padding-top: 80px;
    padding-bottom: 48px;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  .footer {
    border-top: 1px solid #262626;
    padding: 2rem 0;
    text-align: center;
  }
  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .work-together {
    margin-bottom: 1rem;
  }
  .work-together h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.5rem 0;
  }
  .work-together p {
    font-size: 0.875rem;
    color: #a3a3a3;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }
  .work-together-email {
    color: #a3a3a3;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .work-together-email:hover,
  .work-together-email:focus {
    color: #fff;
    outline: 2px solid #22c55e;
    outline-offset: 2px;
  }
  .footer p {
    font-size: 0.875rem;
    color: #9e9e9e;
  }
   .footer-links {
     display: flex;
     justify-content: center;
     gap: 1.5rem;
     margin-bottom: 0.5rem;
   }
  .footer-links a {
    color: #9e9e9e;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .footer-links a:hover,
  .footer-links a:focus {
    color: #a3a3a3;
    outline: 2px solid #22c55e;
    outline-offset: 2px;
  }
   .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
