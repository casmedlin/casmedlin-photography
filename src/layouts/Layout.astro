---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  heading?: string;
  schemaType?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description = 'Photography portfolio by Cas Medlin, freelance photographer based in Iredell County, North Carolina specializing in landscapes, wildlife, portraits, events, pets, and astrophotography.', image = '/favicon.webp', canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site ?? 'https://casmedlin.com').toString(), heading, schemaType = 'WebPage', breadcrumbs = [] } = Astro.props;
const siteName = 'Cas Medlin';
const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site ?? 'https://casmedlin.com').toString();
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site ?? 'https://casmedlin.com').toString();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/portraits', label: 'Portraits' },
  { href: '/events', label: 'Events' },
  { href: '/pets', label: 'Pets' },
  { href: '/wildlife', label: 'Wildlife' },
  { href: '/landscapes', label: 'Landscapes' },
  { href: '/architecture', label: 'Architecture' },
  { href: '/astrophotography', label: 'Astrophotography' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '').replace(/\/index\.html$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#151515" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/webp" href="/favicon.webp" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.ico" sizes="64x64" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonical} />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Cas Medlin" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="p:domain_verify" content="5d28a2e665f247781875ef2d5925d719" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@casmedlin" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': schemaType,
          name: `${title} | ${siteName}`,
          description: description,
          url: pageUrl,
          image: ogImage,
          author: {
            '@type': 'Person',
            name: siteName,
            url: Astro.site?.toString(),
            sameAs: [
              'https://instagram.com/casmedlin',
              'https://facebook.com/casmedlin1',
              'https://youtube.com/@casmedlin'
            ]
          },
          publisher: {
            '@type': 'Person',
            name: siteName,
            image: ogImage
          }
        },
        {
          '@type': 'Person',
          name: siteName,
          jobTitle: 'Freelance Photographer, Graphic Designer & IT Consultant',
          description: description,
          url: Astro.site?.toString(),
          image: ogImage,
          email: 'mailto:info@casmedlin.com',
          sameAs: [
            'https://instagram.com/casmedlin',
            'https://facebook.com/casmedlin1',
            'https://youtube.com/@casmedlin'
          ],
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Iredell County',
            addressRegion: 'NC',
            addressCountry: 'US'
          },
          knowsAbout: ['Landscape Photography', 'Wildlife Photography', 'Portrait Photography', 'Event Photography', 'Pet Photography', 'Astrophotography', 'Architecture Photography', 'Graphic Design', 'IT Consulting', 'Web Design', 'Video Editing', 'Social Media Management']
        },
        ...(breadcrumbs.length > 0 ? [{
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://casmedlin.com/' },
            ...breadcrumbs.map((crumb, i) => ({
              '@type': 'ListItem',
              position: i + 2,
              name: crumb.name,
              item: crumb.url.startsWith('http') ? crumb.url : `https://casmedlin.com${crumb.url}`
            }))
          ]
        }] : [])
      ]
    })} />

    <!-- Resource Hints for performance -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preload" href="/main.js" as="script" />

    <!-- Core Web Vitals monitoring -->
    <script is:inline src="/vitals.js" defer></script>

    <!-- Google tag (gtag.js) - Deferred for performance -->
    <script type="text/javascript" client:load>
      (function() {
        var loadGTM = function() {
          if (window.gtag) return;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-5LHBPEXY32';
          document.head.appendChild(script);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-5LHBPEXY32');
          window.gtag = gtag;
        };

        var interactionEvents = ['scroll', 'mousemove', 'touchstart'];
        var loadOnInteraction = function() {
          loadGTM();
          interactionEvents.forEach(function(evt) {
            document.removeEventListener(evt, loadOnInteraction);
          });
        };

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          loadGTM();
        } else {
          interactionEvents.forEach(function(evt) {
            document.addEventListener(evt, loadOnInteraction, { once: true });
          });
          setTimeout(loadGTM, 5000);
        }
      })();
    </script>

    <!-- Main script with deferred loading -->
    <script is:inline src="/main.js" defer></script>

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class={['/about', '/about/'].includes(Astro.url.pathname) ? 'about-page' : ''}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <nav class="nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/favicon.webp" alt="Cas Medlin Photography" class="logo-img" width="32" height="32" />
          <span class="logo-text">{siteName}</span>
        </a>
        <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links" id="nav-links" role="menubar">
          {navLinks.map((link) => (
            <a href={link.href} class="nav-link" role="menuitem" aria-current={Astro.url.pathname === link.href || (link.href !== '/' && Astro.url.pathname.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-content">
